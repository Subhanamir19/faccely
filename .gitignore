# Ignore Expo local state in nested projects
**/.expo/

# Agent/local caches
**/.npm-cache/
npm-cache-*/

# Local agent settings
.claude/settings.local.json

# Skills/agents (contain symlinks that break EAS build uploads)
.agents/
screenshots/

# Metro/Expo build artifacts (a bundled index.bundle.js was committed by mistake)
**/.tmp/
**/dist/

# Stray working files at repo root (duplicates of facely/assets, scratch mockups, logs)
/*.otf
/*.html
/*.png
/*.log
.tools/
