{
  "expo": {
    "name": "Sigma Max",
    "slug": "sigmamax-app",
    "version": "1.17.0",
    "orientation": "portrait",
    "icon": "./assets/sigmamax-real-updatred-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "buildNumber": "26",
      "bundleIdentifier": "com.sigmamax.app",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "SigmaMax needs camera access to analyze your facial features and provide personalized recommendations.",
        "NSPhotoLibraryUsageDescription": "SigmaMax needs photo library access to analyze photos of your face."
      }
    },
    "android": {
      "package": "com.sigmamax.app",
      "versionCode": 16,
      "adaptiveIcon": {
        "foregroundImage": "./assets/sigmamax-real-updatred-logo.png",
        "backgroundColor": "#ffffff"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/sigmamax-logo-for-splash screen.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "SigmaMax needs camera access to analyze your facial features and provide personalized recommendations.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SigmaMax needs photo library access to analyze photos of your face."
        }
      ],
      "expo-web-browser",
      "./plugins/withExcludeFromBackup",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-video"
    ],
    "scheme": "sigmamax",
    "experiments": {
      "reactCompiler": true
    },
    "assetBundlePatterns": [
      "assets/fonts/*",
      "assets/**/*"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2260139b-8e0a-4bb6-a992-9c56af42e7d7"
      }
    },
    "owner": "sigmamax2"
  }
}
